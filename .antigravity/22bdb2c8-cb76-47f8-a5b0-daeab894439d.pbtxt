      arguments_json: "{\"CodeContent\":\"package com.example.MainActivity\\n\\nimport android.os.Bundle\\nimport androidx.activity.ComponentActivity\\nimport androidx.activity.compose.setContent\\nimport androidx.activity.enableEdgeToEdge\\nimport androidx.activity.viewModels\\nimport androidx.compose.foundation.layout.Box\\nimport androidx.compose.foundation.layout.fillMaxSize\\nimport androidx.compose.foundation.layout.padding\\nimport androidx.compose.material3.Scaffold\\nimport androidx.compose.runtime.*\\nimport androidx.compose.ui.Modifier\\nimport androidx.lifecycle.compose.collectAsStateWithLifecycle\\nimport androidx.navigation.NavType\\nimport androidx.navigation.compose.NavHost\\nimport androidx.navigation.compose.composable\\nimport androidx.navigation.compose.currentBackStackEntryAsState\\nimport androidx.navigation.compose.rememberNavController\\nimport androidx.navigation.navArgument\\nimport com.example.ui.components.AnimatedTopBar\\nimport com.example.ui.screens.*\\nimport com.example.ui.theme.BossVsLeaderTheme\\nimport com.example.viewmodel.MainViewModel\\n\\nclass MainActivity : ComponentActivity() {\\n    private val viewModel: MainViewModel by viewModels()\\n\\n    override fun onCreate(savedInstanceState: Bundle?) {\\n        super.onCreate(savedInstanceState)\\n        enableEdgeToEdge()\\n        setContent {\\n            val userStats by viewModel.userStats.collectAsStateWithLifecycle()\\n            val darkTheme = when (userStats.themeMode) {\\n                \\\"DARK\\\" -> true\\n                \\\"LIGHT\\\" -> false\\n                else -> androidx.compose.foundation.isSystemInDarkTheme()\\n            }\\n\\n            BossVsLeaderTheme(darkTheme = darkTheme) {\\n                val navController = rememberNavController()\\n                val navBackStackEntry by navController.currentBackStackEntryAsState()\\n                val currentRoute = navBackStackEntry?.destination?.route ?: \\\"splash\\\"\\n\\n                val lessons by viewModel.lessons.collectAsStateWithLifecycle()\\n                val quizQuestions by viewModel.quizQuestions.collectAsStateWithLifecycle()\\n                val quizResults by viewModel.quizResults.collectAsStateWithLifecycle()\\n                val selectedCategory by viewModel.selectedCategory.collectAsStateWithLifecycle()\\n\\n                val showTopBar = currentRoute != \\\"splash\\\" && !currentRoute.startsWith(\\\"lesson_detail\\\")\\n\\n                Scaffold(\\n                    modifier = Modifier.fillMaxSize(),\\n                    topBar = {\\n                        if (showTopBar) {\\n                            AnimatedTopBar(\\n                                currentRoute = currentRoute,\\n                                streakDays = userStats.streakDays,\\n                                onTabSelected = { route ->\\n                                    if (route != currentRoute) {\\n                                        navController.navigate(route) {\\n                                            popUpTo(\\\"home\\\") { saveState = true }\\n                                            launchSingleTop = true\\n                                            restoreState = true\\n                                        }\\n                                    }\\n                                }\\n                            )\\n                        }\\n                    }\\n                ) { innerPadding ->\\n                    Box(modifier = Modifier.padding(innerPadding)) {\\n                        NavHost(\\n                            navController = navController,\\n                            startDestination = \\\"splash\\\"\\n                        ) {\\n                            composable(\\\"splash\\\") {\\n                                SplashScreen(\\n                                    onTimeout = {\\n                                        navController.navigate(\\\"home\\\") {\\n                                            popUpTo(\\\"splash\\\") { inclusive = true }\\n                                        }\\n                                    }\\n                                )\\n                            }\\n                            composable(\\\"home\\\") {\\n                                HomeScreen(\\n                                    lessons = lessons,\\n                                    userStats = userStats,\\n                                    onLessonClick = { lessonId ->\\n                                        navController.navigate(\\\"lesson_detail/$lessonId\\\")\\n                                    },\\n                                    onNavigate = { route ->\\n                                        navController.navigate(route) {\\n                                            popUpTo(\\\"home\\\") { saveState = true }\\n                                            launchSingleTop = true\\n                                            restoreState = true\\n                                        }\\n                                    }\\n                                )\\n                            }\\n                            composable(\\\"lessons\\\") {\\n                                LessonsScreen(\\n                                    lessons = lessons,\\n                                    selectedCategory = selectedCategory,\\n                                    onCategorySelected = { viewModel.setSelectedCategory(it) },\\n                                    onLessonClick = { lessonId ->\\n                                        navController.navigate(\\\"lesson_detail/$lessonId\\\")\\n                                    },\\n                                    onToggleCompletion = { lessonId ->\\n                                        viewModel.toggleCompletion(lessonId)\\n                                    }\\n                                )\\n                            }\\n                            composable(\\n                                route = \\\"lesson_detail/{lessonId}\\\",\\n                                arguments = listOf(navArgument(\\\"lessonId\\\") { type = NavType.IntType })\\n                            ) { backStackEntry ->\\n                                val lessonId = backStackEntry.arguments?.getInt(\\\"lessonId\\\") ?: 1\\n                                val lesson = lessons.find { it.id == lessonId }\\n                                LessonDetailScreen(\\n                                    lesson = lesson,\\n                                    onBack = { navController.popBackStack() },\\n                                    onToggleBookmark = { id -> viewModel.toggleBookmark(id) },\\n                                    onToggleCompletion = { id -> viewModel.toggleCompletion(id) }\\n                                )\\n                            }\\n                            composable(\\\"compare\\\") {\\n                                CompareScreen(lessons = lessons)\\n                            }\\n                            composable(\\\"quiz\\\") {\\n                                QuizScreen(\\n                                    questions = quizQuestions,\\n                                    onSubmitScore = { score, total, onComplete ->\\n                                        viewModel.submitQuizScore(score, total, onComplete)\\n                                    }\\n                                )\\n                            }\\n                            composable(\\\"profile\\\") {\\n                                ProfileScreen(\\n                                    lessons = lessons,\\n                                    quizResults = quizResults,\\n                                    userStats = userStats,\\n                                    onLessonClick = { lessonId ->\\n                                        navController.navigate(\\\"lesson_detail/$lessonId\\\")\\n                                    },\\n                                    onThemeChanged = { mode ->\\n                                        viewModel.setThemeMode(mode)\\n                                    },\\n                                    onResetProgress = {\\n                                        viewModel.resetAllProgress {}\\n                                    }\\n                                )\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n    }\\n}\\n\",\"Description\":\"Implement MainActivity with Navigation Compose and app state flow\",\"Overwrite\":true,\"TargetFile\":\"/app/src/main/java/com/example/MainActivity.kt\",\"toolAction\":\"Creating MainActivity\",\"toolSummary\":\"Create MainActivity component\"}"
