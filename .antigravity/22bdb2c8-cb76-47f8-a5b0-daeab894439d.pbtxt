            lines {
              text: "# BossVsLeader Android Application"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "BossVsLeader is a modern micro-learning application built with Kotlin, Jetpack Compose, and Material 3, designed to teach leadership excellence by contrasting Boss behaviors (command, control, blame) with Leader behaviors (inspire, coach, take responsibility)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## User Review & Critical Decisions"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "> [!IMPORTANT]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "> The user confirmed the following preferences in Phase 1:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Visual Accent Theme**: Dynamic Boss Red (#D32F2F) and Leader Blue (#0288D1) gradient aesthetic with polished M3 surfaces."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Initial Screen**: Home dashboard featuring greeting, streak flame counter, progress ring, and \"Lesson of the Day\"."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Quiz Structure**: Relaxed self-paced learning mode with instant explanations and immediate feedback."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Confirmed Decision 1**: SQLite persistence via custom `DatabaseHelper` (SQLiteOpenHelper) running on `Dispatchers.IO`, pre-seeded with 20 rich lessons and 30 quiz questions on first launch."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Confirmed Decision 2**: Signature 3-second animated splash screen with spring-animated crown and fading whistle icons, leading directly to the Home dashboard."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Confirmed Decision 3**: Custom animated top navigation bar with collapsing scroll behavior, shifting gradient background, and animated tab indicator pill."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 1. Overview & Core Concept"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **What It Does**: Teaches users effective leadership principles through interactive lessons, side-by-side behavioral comparisons, self-paced quizzes, bookmarking, and streak/progress tracking."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Target Audience**: Aspiring managers, team leads, professionals, and anyone looking to transition from traditional boss mentalities to inspiring leadership."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Key Value**: Engaging micro-learning architecture with immediate practical takeaways, offline SQLite storage, and gorgeous M3 animations."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 2. User Experience & Visual Design"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Key User Flows**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. **Splash Screen**: 3-second branded animation with progress bar -> Home dashboard."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. **Home Dashboard**: Daily greeting, streak counter with pulse, progress ring, lesson of the day, quick category access."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. **Lessons Catalog & Detail**: Categorized lazy column with read times and completion checkmarks; detail view with side-by-side Boss (red panel) vs Leader (blue panel) breakdown, scenarios, key takeaways, and bookmarking."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. **Compare Mode**: Swipeable horizontal pager of \"Boss says vs Leader says\" flip cards."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  5. **Quiz Mode**: Self-paced questions with instant feedback, explanations, score tallying, and persistent history saved to SQLite."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  6. **Profile & Stats**: Comprehensive learning analytics, bookmarks list, dark/light theme toggle, and progress reset option."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Visual Identity & Theme**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Aesthetic Direction*: Polished, premium micro-learning experience with warm Boss red accents, cool Leader blue/teal highlights, and deep charcoal/slate surfaces."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Color Palette & Mood*: Material 3 ColorScheme with custom dynamic gradient headers (`rememberInfiniteTransition`), soft tonal elevation, and glassmorphic card overlays."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Typography & Hierarchy*: Clean Material 3 typography scale utilizing `sp` units for fluid accessibility scaling."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 1: SQLite via SQLiteOpenHelper vs Room**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Raw SQLite with explicit DAO-style repository wrapper and coroutines (`Dispatchers.IO`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Matches exact prompt requirements, avoids heavy annotation processors while providing robust, reliable local offline storage."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decision 2: Custom Animated Top Navigation Bar**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Chosen Approach*: Custom collapsible app bar with animated gradient background, sliding tab indicator pill, and cross-fading destination titles."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Why*: Delivers the high-end polished experience specified in the app concept without generic template constraints."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
